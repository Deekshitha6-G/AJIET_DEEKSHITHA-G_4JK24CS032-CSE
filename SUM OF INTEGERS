/////kth largest no;
class Main {
    public static void main(String[] args) {
        int[] arr = {7, 10, 4, 3, 20, 15};
        int k = 3;

        int result = kthlargest(arr, k);
        System.out.println("Kth largest element: " + result);
    }

    public static int kthlargest(int[] arr, int k) {
        java.util.Arrays.sort(arr);  // sort in ascending order
        return arr[arr.length - k];  // pick from the end
    }
}

///kth smallest no
class Main {
    public static void main(String[] args) {
        int[] arr = {7, 10, 4, 3, 20, 15};
        int k = 3;  // example

        int result = kthsmallest(arr, k);
        System.out.println("Kth smallest element: " + result);
    }

    public static int kthsmallest(int[] arr, int k) {
        java.util.Arrays.sort(arr);  // sort in ascending order
        return arr[k - 1];  // pick from the start
    }



//// reverse a string
public class Main {

    public static void reverseInPlace(int[] arr) {
        if (arr == null) return;

        int start = 0;
        int end = arr.length - 1;

        while (start < end) {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;

            start++;
            end--;
        }
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5};

        reverseInPlace(arr);

        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}}
